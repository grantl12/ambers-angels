#Download dependencies 

sudo apt update && sudo apt upgrade -y
sudo apt install -y build-essential libpcre3 libpcre3-dev libssl-dev zlib1g-dev git ffmpeg

cd /tmp

# Download nginx
wget http://nginx.org/download/nginx-1.24.0.tar.gz
tar -zxvf nginx-1.24.0.tar.gz

# Download RTMP module
git clone https://github.com/arut/nginx-rtmp-module.git

cd nginx-1.24.0

# Compile nginx with RTMP
./configure --add-module=../nginx-rtmp-module
make
sudo make install


#Configure RTMP
sudo nano /usr/local/nginx/conf/nginx.conf
worker_processes auto;

events {
    worker_connections 1024;
}
rtmp {
    server {
        listen 1935;
        chunk_size 1024;   # smaller = lower latency

        application live {
            live on;


            # latency tuning
            wait_key off;
            sync 100ms;
        }
    }
}

http {
    server {
        listen 8080;

        location / {
            return 200 "RTMP Server Running";
        }
    }
}

#Start Server
sudo /usr/local/nginx/sbin/nginx

#Broadcast Stream
ffmpeg -i rtmp://localhost/live/drone1 -c copy -f flv rtmp://localhost/live/stable

#Start recording
ffmpeg -i rtmp://localhost/live/stable \
-c copy \
-f segment \
-segment_time 10 \
-reset_timestamps 1 \
recording_%03d.mp4

#Start ALPR
#sudo apt install docker.io -y
docker run -it --rm -v /root/frames:/data openalpr/openalpr -c us /data/frame_0001.jpg
