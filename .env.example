# Amber's Angels — environment variables
# Copy this file to .env and fill in your values before running pm2 start.
# .env is gitignored and must never be committed.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@127.0.0.1:5432/ambersangels

# ── Authentication ────────────────────────────────────────────────────────────
# Secret key for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Notifications ─────────────────────────────────────────────────────────────
# Discord webhook URL for watchlist-hit alerts.
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Optional: Plate Recognizer cloud API (make/model enrichment) ───────────────
# Free tier: 2,500 lookups/month. Leave blank to disable cloud enrichment.
# PLATE_RECOGNIZER_TOKEN=

# ── Optional: SMTP (volunteer approval emails) ────────────────────────────────
# Leave blank to disable outbound email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM=noreply@amberangels.org

# ── Optional: FEMA poll tuning ────────────────────────────────────────────────
# FEMA_POLL_INTERVAL=300      # seconds between polls (default 300)
# FEMA_LOOKBACK_MINUTES=60    # lookback window for recent alerts (default 60)

# ── Optional: YOLO model ──────────────────────────────────────────────────────
# YOLO_MODEL_PATH=yolov8n.pt  # ultralytics will download on first run

# ── Optional: Golden frames directory ────────────────────────────────────────
# Where alert frame thumbnails are saved. Defaults to backend/test_plates/golden_frames
# GOLDEN_DIR=/home/ambers-angels/proj_dir/ambers-angels/backend/test_plates/golden_frames
