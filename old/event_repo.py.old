import uuid
from datetime import datetime, timedelta, timezone
from typing import Optional
from sqlalchemy import select, update, and_, text
from services.detection_models import DetectionEvent, EventStatus, EventClassification, DetectionEventCreate

class EventRepository:
    def __init__(self, session_factory):
        self.session_factory = session_factory

    async def get_active_event_by_group_key(self, group_key: str) -> Optional[DetectionEvent]:
        """
        Finds an existing event based on the unique group_key (drone:plate:bucket).
        """
        async with self.session_factory() as session:
            # Explicitly select the class
            query = select(DetectionEvent).filter(
                DetectionEvent.dedupe_key == group_key
            )
            result = await session.execute(query)
            # Use .scalar_one_or_none() for cleaner async handling
            return result.scalar_one_or_none()
    async def create_event(self, event_data: DetectionEventCreate) -> DetectionEvent:
        """Creates a new high-level detection event in the database."""
        async with self.session_factory() as session:
            # Convert Pydantic model to dict if necessary
            data = event_data.dict() if hasattr(event_data, "dict") else event_data
            new_event = DetectionEvent(**data)
            session.add(new_event)
            await session.commit()
            await session.refresh(new_event)
            return new_event

    async def update_event(self, event: DetectionEvent, fields: dict) -> DetectionEvent:
        """Updates an existing active event with new aggregation data."""
async with self.session_factory() as session:
            # Instead of a complex update() statement which causes the ArgumentError,
            # we use the 'merge' pattern which is much safer for async objects
            
            # 1. Update the attributes on the object we already have
            for key, value in fields.items():
                setattr(event, key, value)
            
            # 2. Merge it into the current session to save changes
            updated_event = await session.merge(event)
            await session.commit()
            return updated_event

    async def attach_detection_to_event(self, detection_id: uuid.UUID, event_id: uuid.UUID):
        """Links a raw detection to a high-level event (Many-to-One)."""
        async with self.session_factory() as session:
            # Assuming you have a 'detections' table with an 'event_id' foreign key
            query = text("UPDATE detections SET event_id = :eid WHERE id = :did")
            await session.execute(query, {"eid": event_id, "did": detection_id})
            await session.commit()
