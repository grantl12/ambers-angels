import os
import time
import requests
import logging

# --- Configuration ---
# Hardcoded to your project path to prevent the /root/ error
DEFAULT_PATH = "/home/ambers-angels/proj_dir/ambers-angels/backend/test_plates"
FRAME_ROOT = os.getenv("FRAME_ROOT", DEFAULT_PATH)
DRONE_ID = os.getenv("DRONE_ID", "drone1")
API_BASE = os.getenv("API_BASE", "http://127.0.0.1:8000")


# This creates a file called 'worker_debug.log' in your worker folder
logging.basicConfig(
    filename='/home/ambers-angels/proj_dir/ambers-angels/worker/worker_debug.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)

# In your processing loop, add this:
logging.info(f"Processing {filename}...")
# After the ALPR line:
logging.info(f"ALPR Result: {plate_text} with {confidence}% confidence")


# Set up a dedicated Hit Logger
hit_logger = logging.getLogger('hits')
hit_logger.setLevel(logging.INFO)
handler = logging.FileHandler('/home/ambers-angels/proj_dir/ambers-angels/worker/hits.log')
hit_logger.addHandler(handler)

def handle_detection(plate, confidence):
    # 1. Log to the permanent file
    hit_msg = f"TIMESTAMP: {time.time()} | PLATE: {plate} | CONF: {confidence:.2f}"
    hit_logger.info(hit_msg)
    
    # 2. High-Visibility Terminal Output
    print("\n" + "="*50)
    print(f"🚨 TARGET SPOTTED: {plate} ({confidence*100:.1f}%)")
    print("="*50 + "\n")

def process_loop():
    watch_dir = os.path.join(FRAME_ROOT, DRONE_ID)
    
    # Ensure the directory exists before we try to read it
    if not os.path.exists(watch_dir):
        try:
            os.makedirs(watch_dir)
            print(f"📁 Created directory: {watch_dir}")
        except Exception as e:
            print(f"❌ Permission Error: Cannot create {watch_dir}. {e}")
            return

    print(f"👀 Monitoring: {watch_dir}")
    
    while True:
        try:
            files = [f for f in os.listdir(watch_dir) if f.endswith(('.jpg', '.png'))]
            for filename in files:
                file_path = os.path.join(watch_dir, filename)
                print(f"📸 Found frame: {filename}")
                
                # Logic to send to API
                with open(file_path, 'rb') as f:
                    resp = requests.post(f"{API_BASE}/frames", files={'file': f}, timeout=5)
                
                if resp.status_code == 200:
                    os.remove(file_path) # Clean up after successful upload
            
            time.sleep(1)
        except Exception as e:
            print(f"⚠️ Loop Error: {e}")
            time.sleep(5)

if __name__ == "__main__":
    process_loop()
